        text-align: center;
    }
   #options-container{

    display: inline-block;
    justify-content: center;
   }

/* --- styles moved from color/colors.html --- */
.color-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
            padding: 20px 0;
        }

        .color-card {
            padding: 40px 20px;
            text-align: center;
            border-radius: 15px;
            border: 4px solid #333;
            font-size: 1.5rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            min-height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 10px;
        }

        .color-card:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

        .color-name {
            font-size: 1.3rem;
            margin-top: 10px;
        }

        .color-emoji {
            font-size: 3rem;
        }

        @media (min-width: 480px) {
            .color-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (min-width: 768px) {
            .color-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .color-card {
                min-height: 150px;
            }
        }

/* --- styles moved from emotions/emotions.html --- */
.emotion-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
            padding: 20px 0;
        }

        .emotion-card {
            padding: 40px 20px;
            text-align: center;
            border-radius: 15px;
            border: 4px solid #333;
            font-size: 1.5rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            min-height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 10px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .emotion-card:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

        .emotion-name {
            font-size: 1.3rem;
            margin-top: 10px;
        }

        .emotion-emoji {
            font-size: 3rem;
        }

        @media (min-width: 480px) {
            .emotion-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (min-width: 768px) {
            .emotion-grid {
                grid-template-columns: repeat(4, 1fr);
            }

            .emotion-card {
                min-height: 150px;
            }
        }

