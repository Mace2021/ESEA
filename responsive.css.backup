    body{
        margin: 0;
        padding: 0;
        font-family: 'Itim', cursive;
    }

        #table {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0px auto;
        }

    #computer {
        width: 100px;
        height: 100px;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 5%;
background-color: antiquewhite;

    }
 #me {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 10px;
        background-color: rgb(252, 236, 213);
    }
    #computer img, #me img {
        width: 100px;
        height: 100px;
        margin: 10px;
        cursor: pointer;
        box-shadow: 0px 5px 10px 0px rgba(0, 0, 0, 1); 
    }
    
    #message {
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        margin-top: 5px;
    }

        #countdown {
            font-size: 25px;
            font-weight: bold;
            text-align: center;
            box-shadow: 0px 5px 10px 0px #000;
            width: 150px;
            margin: 0 auto;
            background-color: aqua;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        h2{
            text-align: center;
        }

        #linkto {
