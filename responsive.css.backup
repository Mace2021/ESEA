/* --- styles moved from 123/ran1-10.html --- */
* {
          font-size: x-large;
          font-weight: bold;
          font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
          box-sizing: border-box;
        }

        body {
          background: linear-gradient(120deg, #e0f7fa 0%, #b2dfdb 100%);
          margin: 0;
          min-height: 100vh;
        }

       
        #question {
          width: 340px;
          padding: 16px;
          background: linear-gradient(90deg, #20a1ec 60%, #6ee7f7 100%);
          color: #222;
          border-radius: 8px;
          cursor: pointer;
          display: flex;
          justify-content: center;
          align-items: center;
          position: relative;
          margin: 0 auto;
          left: 50%;
          top: 18%;
          transform: translate(-50%, -50%);
          font-size: 1.4em;
          box-shadow: 0 4px 16px rgba(32,161,236,0.13);
          transition: background 0.2s;
        }
        #question:hover {
          background: linear-gradient(90deg, #1b8fd1 60%, #4fd1c5 100%);
        }

        #message {
          position: relative;
          width: auto;
          padding: 12px 20px;
          font-weight: bold;
          background-color: #fffbe7;
          color: #222;
          text-align: center;
          border-radius: 6px;
       
          box-shadow: 0 2px 8px rgba(255, 215, 0, 0.08);
          
        }

        #board-container {
          display: flex;
          justify-content: center;
          align-items: center;
         
          margin: 30px auto 0 auto;
          flex-wrap: wrap;
          min-height: 100px;
        }

        button {
          border: 3px double #220101;
          width: 80px;
          min-height: 40px;
          padding: 14px 0;
          background-image: linear-gradient(120deg, #558588 0%, #48e6c3 100%);
          color: #220101;
          border-radius: 12px;
          cursor: pointer;
          margin: 10px;
          box-shadow: 0 2px 12px rgba(34, 1, 1, 0.13);
          transition: background 0.2s, transform 0.1s;
          font-size: 2em;
          font-weight: bold;
          font-family: inherit;
          display: flex;
          justify-content: center;
          align-items: center;
        }
        button:hover {
          background-image: linear-gradient(120deg, #48e6c3 0%, #558588 100%);
          transform: scale(1);
        }

        .count123 {
          display: flex;
          flex-wrap: wrap;
          justify-content: center;
          align-items: center;
          width: 200px;
          height: 60px;
          color: #080000;
          padding: 5px;
          box-shadow: 0px 0px 15px rgb(10, 121, 0);
          background-color: rgb(170, 209, 122);
          border-radius: 15px;
          margin: 5px;
          font: 1em sans-serif;
        }

        @media screen and (max-width: 568px) {
          #board-container {
            flex-direction: column;
            width: 100%;
            gap: 10px;
            margin: 10px 0;
          }
          #question {
            width: 60vw;
            font-size: 1em;
            padding: 10px;
            top: 12%;
          }
          #message {
            width: 20vw;
            font-size: 1em;
          }
          button {
            width: 100vw;
            min-width: 0;
            font-size: 1.3em;
            padding: 10px 0;
          }
        }

/* --- styles moved from 123/randnum.html --- */
* {
          font-size: x-large;
          font-weight: bold;
          font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
          box-sizing: border-box;
          margin: 0;
          padding: 0;
        }

        body {
          background: linear-gradient(120deg, #e0f7fa 0%, #b2dfdb 100%);
          min-height: 100vh;
          display: flex;
          flex-direction: column;
          align-items: center;
        }

        a {
          display: block;
          width: 220px;
          text-align: center;
          background-color: #bffaf0;
          margin: 30px auto 0 auto;
          border-radius: 8px;
          padding: 12px 0;
          text-decoration: none;
          color: #222;
          font-size: 1.3em;
          box-shadow: 0 2px 8px rgba(0,0,0,0.07);
          transition: background 0.2s;
        }
        a:hover {
          background: #a0e9de;
        }

        #question {
          width: 320px;
          padding: 16px;
          background-color: #20a1ec;
          color: #fff;
          border-radius: 8px;
          cursor: pointer;
          display: flex;
          justify-content: center;
          align-items: center;
          position: absolute;
          left: 50%;
          top: 120px;
          transform: translate(-50%, 0);
          font-size: 1.4em;
          box-shadow: 0 2px 12px rgba(32,161,236,0.15);
          transition: background 0.2s;
        }
        #question:hover {
          background-color: #1a7fc2;
        }

        #message {
          position: relative;
          width: 240px;
          font-weight: bold;
          background-color: #fffbe7;
          color: #222;
          text-align: center;
          border-radius: 6px;
          margin: 20px auto 0 auto;
          padding: 10px 0;
          box-shadow: 0 1px 8px rgba(0,0,0,0.08);
          font-size: 1.2em;
        }

        #board-container {
          display: flex;
          flex-wrap: wrap;
          justify-content: center;
          align-items: center;
          gap: 18px;
          margin: 30px auto 0 auto;
          width: 100%;
          max-width: 500px;
        }

        button {
          border: 3px double #220101;
          min-width: 90px;
          min-height: 60px;
          padding: 14px 24px;
          background-image: linear-gradient(120deg, #55b7b8, #48e6c3);
          color: #220101;
          border-radius: 12px;
          cursor: pointer;
          margin: 0 10px;
          box-shadow: 0 2px 10px rgba(34, 1, 1, 0.13);
          transition: background 0.2s, transform 0.2s;
          font-size: 2em;
          font-weight: bold;
          font-family: inherit;
          outline: none;
        }
        button:hover, button:focus {
          background-image: linear-gradient(120deg, #48e6c3, #55b7b8);
          transform: scale(1.07);
          box-shadow: 0 4px 16px rgba(34, 1, 1, 0.18);
        }

        .count123 {
          display: flex;
          flex-wrap: wrap;
          justify-content: center;
          align-items: center;
          width: 100px;
          height: 85px;
          color: #080000;
          padding: 5px;
          box-shadow: 0px 0px 15px rgb(10, 121, 0);
          background-color: rgb(170, 209, 122);
          border-radius: 15px;
          margin: 5px;
          font: 2em sans-serif;
        }

        @media screen and (max-width: 568px) {
          #board-container {
            flex-direction: column;
            gap: 12px;
            width: 100%;
            margin: 5px auto 0 auto;
            max-width: 95vw;
          }
          #question {
            width: 90vw;
            font-size: 1.1em;
            top: 90px;
          }
          #message {
            width: 90vw;
            font-size: 1em;
          }
          button {
            min-width: 70vw;
            font-size: 1.3em;
            padding: 10px 0;
          }
        }

