/* --- styles moved from tv/storytime.html --- */
body { margin: 0; padding: 0; font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif; background: linear-gradient(180deg, #fff7f0 0%, #ffe8c6 100%); text-align: center; }
    .lesson-card { max-width: 1000px; margin: 1rem auto; padding: 1rem; background: rgba(255,255,255,0.94); border-radius: 24px; box-shadow: 0 14px 30px rgba(0,0,0,0.12); }
    .lesson-card h1 { margin-top: 0; font-size: 2.2rem; }
    .lesson-card p { font-size: 1.05rem; line-height: 1.7; margin: 0.8rem auto; max-width: 760px; }
    .video-wrapper { position: relative; width: 100%; padding-top: 56.25%; margin-top: 1rem; }
    .video-wrapper video { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border-radius: 18px; }
    a.back-link { display: inline-block; margin-top: 0.8rem; padding: 0.8rem 1.2rem; background: #ffd57a; color: #092343; border-radius: 999px; text-decoration: none; font-weight: 900; }

/* --- styles moved from tv/tv.html --- */
*{
            
            font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
            font-size: 30px;
            font-weight: bolder;
           
        }
        #linkto {
            font-size: 1.5em;
            font-weight: bold;
            text-align: center;
            margin: 0 auto;
            background-color: #eee6c2;
            border-radius: 5px;
            width: 50%;
            justify-self: center;
        }
            @media (max-width: 768px) {
        #iframe-container {
            height: auto;
            padding: 20px;
            border-radius: 15px;
        }
        
        iframe {
            width: 100%;
            height: 40vw;
        }
    }
    #container {
        display: flex;
        justify-content: space-between;
    }
    #sidebar {
        width: 25%;
        padding: 20px;
        background-color: #f0f0f0;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
    #sidebar h3 {
        color: #333;
        border-bottom: 2px solid #ddd;
        padding-bottom: 10px;
        margin-bottom: 15px;
    }
    #mytv {
        width: 70%;
    }
    #videoList {
        list-style-type: none;
        padding: 0;
    }

    #videoList li:nth-child(odd) {
        margin-bottom: 10px;
        padding: 8px;
        background-color: #94fd63;
        border-radius: 5px;
        transition: background-color 0.3s ease;
    }
    #videoList li:nth-child(even) {
        margin-bottom: 10px;
        padding: 8px;
        background-color: #f0f0f0;
        border-radius: 5px;
        transition: background-color 0.3s ease;
    }
    #videoList li:hover {
        background-color: #d0d0d0;
        cursor: pointer;
    }

/* --- styles moved from weather/weather.html --- */
.weather-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
            padding: 20px 0;
        }

        .weather-card {
            padding: 30px 20px;
            text-align: center;
            border-radius: 15px;
            border: 4px solid white;
            font-size: 1.3rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            min-height: 140px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 10px;
            color: white;
        }

        .weather-card:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

        .weather-name {
            font-size: 1.2rem;
            margin-top: 10px;
        }

        .weather-emoji {
            font-size: 3rem;
        }

        @media (min-width: 480px) {
            .weather-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (min-width: 768px) {
            .weather-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .weather-card {
                min-height: 160px;
            }
        }
