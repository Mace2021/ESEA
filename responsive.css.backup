  display: flex;
  justify-content: center;
  align-items: center;
  width: 15%;
  min-width: 60px;
  aspect-ratio: 1 / 1;
  color: #080000;
  padding: 5px;
  box-shadow: 0px 0px 15px  rgb(10, 121, 0);
  background-color: rgb(170, 209, 122);
  border-radius: 15px;
  margin: 0;
  border-style: double;
  font-size: 2em;
  font-weight: bolder;
  transition: background 0.2s;
}
@media (max-width: 600px) {
  #board-container {
    grid-template-columns: repeat(auto-fit, minmax(45px, 1fr));
    max-width: 100vw;
  }
  .count123 {
    font-size: 1.2em;
    min-width: 35px;
  }
}
