            align-items: center;
        }

/* --- styles moved from games/tictactoe.html --- */
* {
      font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
      font-size: 30px;
      font-weight: bolder;
    }

    .display {
      color: rgb(15, 0, 0);
      font-size: 20px;
      text-align: center;
      margin-top: 1em;
      margin-bottom: 1em;
      background-color: rgb(235, 243, 199);
      width: 50%;
      margin: 0 auto;
    }

    .hide {
      display: none;
    }

    .container {
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(3, 1fr);
      max-width: 300px;
      gap: 5px;
    }

    @media (max-width: 600px) {
      .container {
        max-width: 95vw;
      }
    }

    .tile {
      width: 100%;
      border: 3px solid rgb(251, 251, 253);
      min-width: 50%;
      min-height: 80px;
      display: flex;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      background-color: #9F6347;
      margin: 0 auto;
      transition: background 0.2s;
    }

    .tile.playerball {
      background-color: #e0ffe0;
    }

    .tile.playerapple {
      background-color: #e0eaff;
    }

    .playerball {
      color: #09C372;
    }

    .playerapple {
      color: #498AFB;
    }

    .controls {
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: center;
      margin-top: 1em;
    }

    .controls button {
      color: rgb(1, 9, 22);
      padding: 8px;
      border-radius: 8px;
      border: none;
      font-size: 20px;
      margin-left: 1em;
      cursor: pointer;
    }

    .restart {
      background-color: #498AFB;
    }

    #reset {
      background-color: #389fff;
    }

    img {
      width: 65%;
      pointer-events: none;
      user-select: none;
    }

    #linkto {
      font-size: 1.5em;
      font-weight: bolder;
      text-align: center;
      margin: 0 auto;
      background-color: #1fe0c6;
      border-radius: 5px;
      width: 150px;
      justify-self: center;
      color: #000;
      display: block;
      text-decoration: none;
      margin-bottom: 10px;
    }

    .center-container {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      background: none;
    }

/* --- styles moved from index.html --- */
/* Local header styling adjustments */
        .logo-container {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 10px;
        }

        .logo-container img {
            max-width: 80px;
            height: auto;
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        header h1 {
            margin: 0;
            font-size: 2rem;
        }

        header p {
            margin: 0;
            font-size: 1rem;
            opacity: 0.9;
        }

        /* Category cards grid */
        .categories-section {
            margin-bottom: 40px;
        }

        .section-title {
            font-size: 1.8rem;
            font-weight: bold;
            margin: 30px 0 20px 0;
            text-align: center;
            color: white;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        /* Welcome message */
        .welcome-message {
            background: rgba(255, 255, 255, 0.95);
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 30px;
            text-align: center;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border: 3px solid white;
        }

        .welcome-message h2 {
            color: #667eea;
            font-size: 1.6rem;
            margin: 0 0 10px 0;
        }

        .welcome-message p {
            color: #333;
            font-size: 1.1rem;
            margin: 0;
        }

        /* Responsive adjustments */
        @media (min-width: 480px) {
            header h1 {
                font-size: 2.3rem;
            }

            .section-title {
                font-size: 2rem;
            }
        }

        @media (min-width: 768px) {
            header h1 {
                font-size: 2.5rem;
            }

            .section-title {
                font-size: 2.2rem;
            }
        }

/* --- styles moved from puzzles/gamification.html --- */
.dashboard-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
            padding: 20px 0;
        }

        .stat-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border: 3px solid #667eea;
        }

        .stat-value {
            font-size: 2.5rem;
            font-weight: bold;
            color: #667eea;
            margin: 10px 0;
        }

        .stat-label {
            font-size: 1rem;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .level-indicator {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 15px;
            text-align: center;
            margin: 20px 0;
        }

        .level-name {
            font-size: 1.5rem;
            font-weight: bold;
            margin-top: 10px;
        }

        .badges-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
            gap: 15px;
            margin: 20px 0;
        }

        .badge {
            background: white;
            border-radius: 50%;
            width: 100px;
            height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border: 3px solid #ffd700;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .badge:hover {
            transform: scale(1.1);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
        }

        .badge-locked {
            opacity: 0.4;
            filter: grayscale(100%);
            border-color: #ccc;
        }

        .progress-bar {
            width: 100%;
            height: 30px;
            background: #e0e0e0;
            border-radius: 15px;
            overflow: hidden;
            margin: 15px 0;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
            width: 0%;
            transition: width 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 0.9rem;
        }

        .module-stats {
            background: white;
            border-radius: 15px;
            padding: 15px;
            margin: 10px 0;
            border-left: 5px solid #667eea;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .module-name {
            font-weight: bold;
            color: #333;
        }

        .module-points {
            font-size: 1.5rem;
            color: #667eea;
            font-weight: bold;
        }

        .reset-btn {
            background: #f5576c;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .reset-btn:hover {
            background: #d93f52;
            transform: scale(1.05);
        }

        @media (min-width: 480px) {
            .dashboard-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (min-width: 768px) {
            .dashboard-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

/* --- styles moved from puzzles/puzzles.html --- */
.puzzle-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
            padding: 20px 0;
        }

        .puzzle-card {
            padding: 30px 20px;
            text-align: center;
            border-radius: 15px;
            border: 4px solid white;
            font-size: 1.2rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            min-height: 140px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 10px;
            color: white;
        }

        .puzzle-card:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

        .puzzle-name {
            font-size: 1.1rem;
            margin-top: 10px;
        }

        .puzzle-emoji {
            font-size: 3rem;
        }

        .matching-area {
            display: grid;
            grid-template-columns: 1fr;
            gap: 15px;
            margin: 20px 0;
        }

        .match-item {
            padding: 15px;
            background: white;
            border: 3px solid #667eea;
            border-radius: 10px;
            text-align: center;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .match-item:hover {
            background: #f0f0f0;
            transform: scale(1.02);
        }

        @media (min-width: 480px) {
            .puzzle-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .matching-area {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (min-width: 768px) {
            .puzzle-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .puzzle-card {
                min-height: 160px;
            }

            .matching-area {
                grid-template-columns: repeat(2, 1fr);
            }
        }

/* --- styles moved from science/bio.html --- */
*{
            font: 3em;
            font-size: x-large;
            
            font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
        }
        body{
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
            margin: 0;
            padding: 0;
        }
        #intro {
            text-align: start;
            margin: 30px;
        }
        #cells{
            width: 100%;
            display: flex;
            flex-wrap: wrap;
            background-color:rgb(247, 245, 245);
           
            justify-content: center;
box-sizing: border-box;

        }

          /* Section rule used to replace inline <hr> styles */
          .section-rule {
            height: 2px;
            background-color: #5e3737;
            border: none;
            margin: 18px auto;
            max-width: 1000px;
          }

          /* Prefer grid layout for large sets of tiles so all items are visible */
          #board-containers {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(64px, 96px));
            gap: 12px;
            justify-content: center;
            align-items: start;
            width: 100%;
            max-width: 1200px;
            margin: 24px auto;
            padding: 0 8px 32px 8px;
          }

        img {
            width: 210px;
            height: auto;
            border: 1px solid #ccc;
            border-radius: 5px;
            padding: 5px;
            margin: 0 auto;
            /* changed margin to margin: auto */
            text-align: center;
            background-color: #f2f2f2;
            box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
            transition: 0.3s;
        }


        img:hover {
            transform: scale(1.1);
            margin: 0 auto;
            /* added margin: 0 auto */
        }


        #plantsCell,#AnimalCell{
            margin: 15px;

        }
        #plantsCelltext,#AnimalCelltext {
            margin: 15px;

        }
        #uCell,#mCell{
            margin: 15px;

        }

        #multicellular,
        #unicellular {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
        }

        #cell-types{
            display: flex;
          flex-wrap: wrap;
          
        }

        .cell-type{
            text-align: center;
            margin: 0 20px;
        }

        .cell-type h4{
            margin-top: 10px;
        }
        #linkto {
            font-size: 1em;
            font-weight: bolder;
            text-align: center;
            margin: 0 auto;
            background-color: #1fe0c6;
            border-radius: 5px;
            width: 150px;
            display: block;
            margin-left: auto;
            margin-right: auto;
            color: #000;
        }

/* --- styles moved from science/chem.html --- */
body { padding: 1rem; background: linear-gradient(180deg, #f6f9ff 0%, #d7e8ff 100%); }
    .lesson-card { max-width: 900px; margin: 0 auto; padding: 1rem; background: rgba(255,255,255,0.92); border-radius: 24px; box-shadow: 0 16px 35px rgba(0,0,0,0.12); }
    .lesson-card h1 { font-size: 2.2rem; margin-bottom: 0.8rem; }
    .lesson-card p { font-size: 1.1rem; line-height: 1.7; margin-bottom: 1rem; }
    .element-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(210px,1fr)); gap: 1rem; margin-top: 1rem; }
    .element-card { background: #eef6ff; border: 3px solid #8ab7ff; border-radius: 18px; padding: 1rem; text-align: center; }
    .element-card h2 { margin: 0.5rem 0 0.2rem; font-size: 1.6rem; }
    .element-card button { margin-top: 0.8rem; padding: 0.8rem 1rem; border: none; border-radius: 999px; background: #7fc2ff; color: #021b47; font-weight: bold; cursor: pointer; }
    #element-detail { margin-top: 1.2rem; padding: 1rem; border-radius: 16px; background: #fff; border: 2px dashed #4c7afb; }

/* --- styles moved from science/compute.html --- */
body { padding: 1rem; background: linear-gradient(180deg, #f5fff2 0%, #c8f7d4 100%); }
    .lesson-card { max-width: 920px; margin: 0 auto; padding: 1rem; background: rgba(255,255,255,0.94); border-radius: 24px; box-shadow: 0 16px 35px rgba(0,0,0,0.12); }
    .lesson-card h1 { font-size: 2.2rem; margin-bottom: 0.8rem; }
    .lesson-card p { font-size: 1.1rem; line-height: 1.7; margin-bottom: 1rem; }
    .concept-list { display: grid; gap: 1rem; margin-top: 1rem; }
    .concept-card { border: 2px solid #55c79f; border-radius: 20px; padding: 1rem; background: #f8fff7; }
    .concept-card h2 { margin: 0 0 0.5rem; }
    .concept-card button { margin-top: 0.8rem; padding: 0.8rem 1rem; border: none; border-radius: 999px; background: #43b675; color: white; font-weight: bold; cursor: pointer; }
    #detail { margin-top: 1.2rem; padding: 1rem; background: #ffffff; border-radius: 18px; border: 2px dashed #55c79f; }

/* --- styles moved from shapes/shapes.html --- */
*{
            
            font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
            font-size: 30px;
            font-weight: bolder;
           
        }
         body {
           margin: 0;
           padding: 0;
        }

        #shapes-container {

            margin: 0 auto;
            width: 100%;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
        
        }



        img {
            width:200px;
          height:200px;
            background-color: rgb(221, 255, 255);
            margin: 2px;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
            transition: all 0.3s ease;
            border-style: double;
        }

        #questions {
      justify-self: center;
      margin: 0 auto;
      width:100%;
    background-color: lightgoldenrodyellow;
      color: #0a0400;
      
      text-align: center;
      box-shadow: #0703c7 0px 0px 20px;
      border-radius: 5px;
      margin-bottom: 20px;
    }

    #message {
        margin: 0 auto;
      position: relative;
